# Required: your Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Optional
KESTREL_MODEL=claude-opus-5-5      # or claude-sonnet-5-5 for cheaper runs
KESTREL_EFFORT=high                # low | medium | high | xhigh | max
KESTREL_MAX_TURNS=60
KESTREL_DATA_DIR=./data/tasks

# Code sandbox: "local" (subprocess on this machine, no isolation) or "docker"
KESTREL_SANDBOX=local
KESTREL_SANDBOX_IMAGE=python:3.12-slim
KESTREL_SANDBOX_NETWORK=bridge     # set to "none" to cut sandbox internet access
